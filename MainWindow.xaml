<Window x:Class="ClickCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numeriq — Counter Studio"
        Width="440"
        Height="440"
        MinWidth="380"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#171717"/>
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E8E8EE"/>
        <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#171717"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid"
          Background="{DynamicResource BackgroundBrush}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="240">

            <TextBlock Text="NUMERIQ"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="CountText"
                       Text="0"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="64"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <Button Content="INCREASE"
                    Height="48"
                    Margin="0,0,0,10"
                    Click="ClickButton_Click"/>

            <Button Content="DECREASE"
                    Height="42"
                    Margin="0,0,0,10"
                    Click="DecreaseButton_Click"/>

            <Button Content="CLEAR COUNT"
                    Height="42"
                    Margin="0,0,0,18"
                    Click="ClearButton_Click"/>

            <Button x:Name="ThemeButton"
                    Content="🌙 Switch to Dark Mode"
                    Height="42"
                    Click="ThemeButton_Click"/>
        </StackPanel>
    </Grid>
</Window>